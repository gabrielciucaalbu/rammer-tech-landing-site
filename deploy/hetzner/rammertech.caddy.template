# rammertech.ro pe Caddy-ul partajat (/opt/edge/sites/rammertech.caddy). deploy.sh înlocuiește __HOSTS__ și __APEX_REDIRECT__.
# `rammertech-web` este aliasul containerului pe rețeaua externă `edge`.
__APEX_REDIRECT__
__HOSTS__ {
	# Un rând JSON per cerere în jurnalul edge-caddy-1; query string-ul e redactat.
	log {
		format filter {
			wrap json
			fields {
				request>uri regexp \?.*$ ?[redacted]
			}
		}
	}
	encode zstd gzip

	# Vercel răspunde 204 la OPTIONS pe pagini (/ro, /en) și pe fișiere statice; Next întoarce 400/405/500 pe aceleași căi.
	# Rutele API și redirecturile (/, /services...) rămân la aplicație, care le tratează ca pe Vercel.
	@options expression `method('OPTIONS') && (path_regexp('^/(ro|en)(/.*)?$') || path_regexp('^/(.*/)?[^/]+[.][^/]+$')) && !path('/api/*', '/_next/*')`
	handle @options {
		header Allow "GET, HEAD, OPTIONS"
		respond 204
	}

	# Fișierele cu hash din build își păstrează cache-ul imuabil trimis de Next.
	handle /_next/static/* {
		header ?Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		reverse_proxy rammertech-web:3000 {
			header_down -X-Powered-By
		}
	}
	# Rutele API rămân cu antetele Next (nu se forțează cache public pe răspunsuri dinamice).
	handle /api/* {
		header ?Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		reverse_proxy rammertech-web:3000 {
			header_down -X-Powered-By
		}
	}
	# Restul se aliniază cu Vercel: fără X-Powered-By și revalidare la fiecare cerere. Se înlocuiește doar valoarea implicită
	# Next (s-maxage=31536000); antetele setate explicit de aplicație (ex. /llms.txt) rămân neatinse.
	handle {
		# Valori implicite doar dacă aplicația nu le-a setat (redirecturile Next nu au Cache-Control/HSTS).
		header ?Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		header ?Cache-Control "public, max-age=0, must-revalidate"
		reverse_proxy rammertech-web:3000 {
			health_uri /ro
			health_interval 15s
			header_down -X-Powered-By
			header_down Cache-Control "^s-maxage=31536000$" "public, max-age=0, must-revalidate"
			# Vercel elimină s-maxage/stale-while-revalidate din răspunsul către client și servește fișierele publice cu must-revalidate.
			header_down Cache-Control "^(public, max-age=[0-9]+), s-maxage=[0-9]+, stale-while-revalidate=[0-9]+$" "$1"
			header_down Cache-Control "^public, max-age=0$" "public, max-age=0, must-revalidate"
			header_down Cache-Control "^public, max-age=14400, must-revalidate$" "public, max-age=0, must-revalidate"
			header_down Cache-Control "^private, no-cache, no-store, max-age=0, must-revalidate$" "public, max-age=0, must-revalidate"
		}
	}
}
